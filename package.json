{
  "name": "angular-aux-routing-poc",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:angular-aux-routing-poc": "node dist/angular-aux-routing-poc/server/server.mjs",
    "customer": "pbjs -t static-module -w es6 ./proto/customer.proto -o src/app/protos/customer/customer.js && pbts --no-comments src/app/protos/customer/customer.js -o src/app/protos/customer/customer.d.ts",
    "cust": "npx pbjs -t static-module -w commonjs -o src/app/protos/customer/customer.js ./proto/customer.proto",
    "proto:customer": "npx pbjs -t static-module -w commonjs -o src/app/protos/customer/customer.js ./proto/customer.proto && npx pbts --no-comments -o src/app/protos/customer/customer.d.ts src/app/protos/customer/customer.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.12",
    "@angular/common": "20.3.12",
    "@angular/compiler": "20.3.12",
    "@angular/core": "20.3.12",
    "@angular/forms": "20.3.12",
    "@angular/platform-browser": "20.3.12",
    "@angular/platform-browser-dynamic": "20.3.12",
    "@angular/platform-server": "20.3.12",
    "@angular/router": "20.3.12",
    "@angular/ssr": "^20.3.10",
    "@grapecity/wijmo": "^5.20251.40",
    "@grapecity/wijmo.angular2.grid": "^5.20251.40",
    "express": "^4.19.2",
    "lodash": "^4.17.21",
    "ol": "10.7.0",
    "rxjs": "^7.4.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.10",
    "@angular/cli": "20.3.10",
    "@angular/compiler-cli": "20.3.12",
    "@types/express": "^4.17.17",
    "@types/jasmine": "5.1.8",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.2.0",
    "jasmine-core": "^5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.5.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "protobufjs": "^7.5.4",
    "typescript": "~5.8.3"
  }
}
